# SaaS Costs Monitor - API Key Configuration
# Copy this file to .env.local and add your API keys
# DO NOT commit .env.local to version control

# Anthropic (Claude API)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT models)
OPENAI_API_KEY=sk-proj-...

# Google Gemini (requires GCP project)
GEMINI_API_KEY=AIzaSy...

# Groq (Groq Cloud)
GROQ_API_KEY=gsk_...

# Grok/xAI
GROK_API_KEY=xai-...

# Cerebras
CEREBRAS_API_KEY=csk-...

# ElevenLabs (Text-to-Speech)
ELEVEN_LABS_KEY=sk_...

# Soniox (Speech Recognition)
SONIOX_API_KEY=snx_proj_...

# Optional: Update interval in seconds (default: 3600)
# UPDATE_INTERVAL=3600

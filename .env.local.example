# Copy to ~/.config/sass-costs/.env (used by the installed app)
# or to ./.env.local (used when running from the repository).
# Never commit the real file.

# Anthropic Admin key (sk-ant-admin...): Console → Settings → Admin keys
ANTHROPIC_ADMIN_KEY=

# OpenAI Admin key: Platform → Organization settings → Admin keys
OPENAI_ADMIN_KEY=

# xAI management key with BillingRead: Console → Settings → Management Keys
XAI_MANAGEMENT_KEY=
# Optional; looked up from the management key when empty
XAI_TEAM_ID=

# ElevenLabs API key (workspace analytics access)
ELEVEN_LABS_KEY=

# Soniox project API key
SONIOX_API_KEY=

# Regular keys are only used to list the provider as "No cost API"
# (or "Needs ..._ADMIN_KEY") in the menu. They are never sent anywhere.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROK_API_KEY=
CEREBRAS_API_KEY=
